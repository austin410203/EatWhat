{
  "name": "eatwhat",
  "compatibility_date": "2026-10-19",
  // 部署前先建置：Cloudflare 只會裝套件再 wrangler deploy，沒有這步 dist/ 不存在
  "build": { "command": "npm run build" },
  // 內部測試：lock/worker.js 先要 Lab 密碼才放行（公開時拿掉 main、binding、run_worker_first、vars）
  "main": "lock/worker.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "LAB_NAME": "EAT WHAT 吃什麼" },
  "routes": [{ "pattern": "eat.emptyoffice.app", "custom_domain": true }],
  // 加了 routes 後 workers.dev 預設會關閉，要明確保留
  "workers_dev": true
}
